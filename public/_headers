/*
# Cloudflare Pages security headers.
# Supabase Auth/API access uses fetch from the browser, so this intentionally
# does not add a restrictive CSP until the deployed asset and auth flows are
# reviewed in the real Pages domain.
# */
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
