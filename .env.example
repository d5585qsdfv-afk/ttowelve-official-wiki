# Cloudflare Pages / browser-safe values. The anon key is publishable and is
# protected by RLS; do not put a service role or any secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false
NEXT_PUBLIC_ENABLE_MAGIC_LINK=false
NEXT_PUBLIC_ENABLE_EMAIL_RECOVERY=false

# Supabase Edge Functions only (set in Supabase project secrets, never Pages).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_in_supabase_secrets_only
ALLOWED_ORIGIN=https://your-production-pages-domain.example

# Local/integration testing only; do not commit real values.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_USER_A=replace_with_test_user_uuid
TEST_USER_B=replace_with_test_user_uuid
